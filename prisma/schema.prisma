generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js models ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  creators      Creator[]         @relation("CreatorOwner")
  messages      OutreachMessage[]
  activities    Activity[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AllowedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  addedBy   String?
  createdAt DateTime @default(now())
}

// ---------- Creator pipeline ----------

enum Platform {
  INSTAGRAM
  X
  TIKTOK
  YOUTUBE
  EMAIL
}

enum Stage {
  TO_CONTACT
  OUTREACH_SENT
  RESPONDED
  CONFIRMED
  CONTRACTED
  POSTED
  DECLINED
}

enum ContractStatus {
  NONE
  DRAFTING
  SENT
  SIGNED
}

enum MessageStatus {
  DRAFT
  SENT
  FAILED
}

model Creator {
  id   String @id @default(cuid())
  name String

  // Contact channels — a creator can have any/all of these at once.
  instagramHandle String?
  xHandle         String?
  tiktokHandle    String?
  youtubeHandle   String?
  email           String?
  phone           String?
  // Which channel outreach defaults to.
  primaryPlatform Platform @default(INSTAGRAM)

  agencyName    String?
  agencyContact String?

  instagramFollowers Int?
  xFollowers         Int?
  tiktokFollowers    Int?
  youtubeFollowers   Int?
  followersUpdatedAt DateTime?

  niche     String?
  notes     String?
  stage     Stage   @default(TO_CONTACT)

  agreedCostCents  Int?
  paidCents        Int?
  paidAt           DateTime?
  contractStatus   ContractStatus @default(NONE)
  contractSentAt   DateTime?
  contractSignedAt DateTime?
  contractNotes    String?

  ownerId String?
  owner   User?   @relation("CreatorOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  messages          OutreachMessage[]
  posts             Post[]
  activities        Activity[]
  followerSnapshots FollowerSnapshot[]
  campaigns         CampaignCreator[]
  contentItems      ContentItem[]
  briefs            CreatorBrief[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
  @@index([primaryPlatform])
}

// Point-in-time follower counts, written on each refresh/edit so the
// dashboard can show growth since the previous check.
model FollowerSnapshot {
  id                 String   @id @default(cuid())
  creatorId          String
  creator            Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  instagramFollowers Int?
  xFollowers         Int?
  tiktokFollowers    Int?
  youtubeFollowers   Int?
  createdAt          DateTime @default(now())

  @@index([creatorId, createdAt])
}

enum CampaignStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

// A push/promo grouping creators — e.g. "March Madness", "NFL Kickoff".
model Campaign {
  id          String            @id @default(cuid())
  name        String
  status      CampaignStatus    @default(ACTIVE)
  budgetCents Int?
  startDate   DateTime?
  endDate     DateTime?
  notes       String?
  // Content pipeline: creators upload via a Google Form into a Drive folder,
  // and the app syncs that folder's files into ContentItem rows.
  driveFolderUrl String?
  driveFolderId  String?
  formUrl        String?
  creators    CampaignCreator[]
  contentItems ContentItem[]
  briefs      CreatorBrief[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

// A per-creator creative brief — published as a branded public page at
// /b/[token] that the creator can open without an account.
model CreatorBrief {
  id                String   @id @default(cuid())
  campaignId        String
  campaign          Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorId         String
  creator           Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  token             String   @unique @default(cuid())
  headline          String?
  intro             String?
  deliverables      String?
  talkingPoints     String?
  dos               String?
  donts             String?
  dueDate           DateTime?
  compensationCents Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([campaignId, creatorId])
}

enum ContentStatus {
  SUBMITTED
  APPROVED
  REJECTED
  POSTED
}

// A piece of creator content attached to a campaign — synced from the
// campaign's Drive folder or added by hand as a link.
model ContentItem {
  id              String        @id @default(cuid())
  campaignId      String
  campaign        Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorId       String?
  creator         Creator?      @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  driveFileId     String?
  name            String
  mimeType        String?
  url             String
  thumbnailUrl    String?
  status          ContentStatus @default(SUBMITTED)
  notes           String?
  driveModifiedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([campaignId, driveFileId])
  @@index([campaignId])
}

model CampaignCreator {
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorId  String
  creator    Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now())

  @@id([campaignId, creatorId])
  @@index([creatorId])
}

// ---------- Marketing content studio ----------

enum PieceFormat {
  REACTION_VIDEO
  PHOTO_SLIDESHOW
  FADE_STORY
  OTHER
}

enum PieceStatus {
  NEEDED
  IN_PROGRESS
  IN_VAULT
  QUEUED
  PUBLISHED
}

// A piece of marketing content: starts as a concept from a source post +
// angle, moves through production into the vault, then gets queued/published.
model ContentPiece {
  id             String      @id @default(cuid())
  title          String
  format         PieceFormat @default(REACTION_VIDEO)
  status         PieceStatus @default(NEEDED)
  theme          String?
  tags           String?
  sourceUrl      String?
  angle          String?
  concept        String?
  assetUrl       String?
  scheduledFor   DateTime?
  publishedUrl   String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status])
}

model Template {
  id        String    @id @default(cuid())
  name      String
  platform  Platform?
  subject   String?
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model OutreachMessage {
  id         String        @id @default(cuid())
  creatorId  String
  creator    Creator       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  channel    Platform
  subject    String?
  body       String
  status     MessageStatus @default(DRAFT)
  isFollowUp Boolean       @default(false)
  sentAt     DateTime?
  sentById   String?
  sentBy     User?         @relation(fields: [sentById], references: [id], onDelete: SetNull)
  resendId   String?
  error      String?
  createdAt  DateTime      @default(now())

  @@index([creatorId])
}

model Post {
  id        String    @id @default(cuid())
  creatorId String
  creator   Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  url       String
  postedAt  DateTime  @default(now())
  views     Int?
  likes     Int?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([creatorId])
}

model Activity {
  id        String   @id @default(cuid())
  creatorId String
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  text      String
  createdAt DateTime @default(now())

  @@index([creatorId])
}
