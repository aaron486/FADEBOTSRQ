# Copy to .env and fill in.

# Postgres connection string (Supabase / Neon / Vercel Postgres / local)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public URL of the deployed app
AUTH_URL="https://your-app.vercel.app"
AUTH_TRUST_HOST="true"

# Require sign-in. Leave unset for open access (anyone with the URL can use
# the app — actions are logged as a shared "FADE Team" user). Set to "true"
# to turn the login page on; then configure APP_PASSWORD and/or Resend below.
REQUIRE_LOGIN=""

# Shared team password sign-in. Set this to use the app WITHOUT Resend —
# teammates sign in with their email + this one password (email must still
# be on the allowlist). Remove later if you want email-link sign-in only.
APP_PASSWORD=""

# Dev-only password-less login button; NEVER set in production
AUTH_DEV_LOGIN=""

# Resend — optional until you want email: powers login magic links and real
# outreach email sending. Without it, outreach emails are simulated/logged.
# Verify your sending domain (fade.bet) in the Resend dashboard first.
RESEND_API_KEY=""
EMAIL_FROM="FADE <outreach@fade.bet>"

# Email seeded into the sign-in allowlist by `npm run db:seed`
SEED_ADMIN_EMAIL="aaron@fade.bet"

# Anthropic Claude — optional: unlocks AI-written/reimagined outreach drafts
# in the composer. Get a key at https://platform.claude.com. Without it, the
# handcrafted scenario library still works.
ANTHROPIC_API_KEY=""
