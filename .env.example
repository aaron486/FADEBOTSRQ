# Copy to .env and fill in.

# Postgres connection string (Supabase / Neon / Vercel Postgres / local)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public URL of the deployed app
AUTH_URL="https://your-app.vercel.app"
AUTH_TRUST_HOST="true"

# Dev-only password-less login button; NEVER set in production
AUTH_DEV_LOGIN=""

# Resend — powers both login magic links and outreach email sending.
# Verify your sending domain (fade.bet) in the Resend dashboard first.
RESEND_API_KEY="re_..."
EMAIL_FROM="FADE <outreach@fade.bet>"

# Email seeded into the sign-in allowlist by `npm run db:seed`
SEED_ADMIN_EMAIL="aaron@fade.bet"
